# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase Dashboard → Project Settings → API
# (.env.local ถูก gitignore ไว้แล้ว ไม่ถูก commit)

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# anon / publishable key (ใช้ฝั่งเบราว์เซอร์ได้ ข้อมูลถูกป้องกันด้วย Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ห้ามใส่ service_role key ในตัวแปร NEXT_PUBLIC_ เด็ดขาด
